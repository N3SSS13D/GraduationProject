# Repository keeps Demo/, Doc/, Project/, .github/ and shared .vscode settings tracked.
# Ignore only local environments, debug snapshots and generated outputs.

# Local Python environment
.venv/

# Root-level generated workspaces
/build/
Project/Debug/

# Legacy reference package outside the current active structure
Project/STC51/Examples/PWMA-DMA/
Project/STC51/Tools
Project/STC51/*.rar
Project/STC51/**/*.rar
Project/STC51/*.RAR
Project/STC51/**/*.RAR

# Build output folders (Keil / embedded / CMake)
**/Objects/
**/Object/
**/Listings/
**/Listing/
**/Output/
**/output/
**/obj/
**/bin/

# Build artifacts
*.o
*.obj
*.d
*.dep
*.su
*.lst
*.map
*.hex
*.bin
*.elf
*.axf
*.crf
*.lnp
*.m51
*.build_log.htm

# Temporary runtime files
*.log
*.bak
*.tmp
*.temp
*.cache
*.pid
*.seed
*.stackdump
*~

# Editor temporary files
*.swp
*.swo
*.orig

# Keil user-specific files (keep shared project files tracked)
*.uvopt
*.uvoptx
*.uvgui.*

# Visual Studio Code / IDE local files
# Keep shared project-level .vscode settings tracked.
.vscode/*.log
.vscode/*.tmp
.vscode/*.temp
.vscode/*.cache
.vscode/*.pid
.vscode/*.seed
.vscode/*.stackdump
.vscode/*~
.vscode/*.code-snippets
.vscode/*.db
.vscode/*.sqlite
.vscode/ipch/
.vscode/.ropeproject/
.idea/
*.code-workspace

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Python cache
**/__pycache__/
*.pyc

# Claude Code local settings
.claude/settings.local.json

# Local demo assets
Demo/Pic/jd-xhh.jpg
Demo/Pic/jd-xhh-16-16.jpg
